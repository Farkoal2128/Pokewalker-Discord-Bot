[Unit]
Description=Pokewalker Discord bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=pokewalker
Group=pokewalker
WorkingDirectory=/opt/pokewalker/current
EnvironmentFile=/etc/pokewalker/runtime.env
LoadCredential=discord_token:/etc/pokewalker/credentials/discord_token
LoadCredential=heartbeat_url:/etc/pokewalker/credentials/heartbeat_url
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/var/cache/pokewalker
ExecStart=/opt/pokewalker/current/.venv/bin/python -m pokewalker run
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
LimitCORE=0
StateDirectory=pokewalker
StateDirectoryMode=0700
CacheDirectory=pokewalker
CacheDirectoryMode=0700
RuntimeDirectory=pokewalker
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pokewalker /var/cache/pokewalker /run/pokewalker
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M
OOMPolicy=stop
CPUQuota=50%
TasksMax=64
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
